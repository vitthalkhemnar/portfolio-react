# ===================================================================
# Firebase Configuration (Cloud Firestore + Firebase Authentication)
# Create a free project at https://console.firebase.google.com/
# Project Settings -> General -> Your apps -> Web app (</>) -> Config
# Copy this file to `.env.local` and paste your project credentials.
#
# NOTE: Admin credentials (email/password) are NOT stored in this file.
# Your admin account is managed securely in Firebase Authentication.
# ===================================================================
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
